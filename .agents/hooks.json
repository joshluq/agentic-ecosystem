{
  "ecosystem-health-gate": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python scripts/hooks/session_start_hook.py",
        "timeout": 15
      }
    ]
  },
  "handoff-validator-gate": {
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/hooks/post_tool_hook.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
